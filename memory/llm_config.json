{
  "default_provider": "local_fast",
  "providers": {
    "mock": {
      "type": "mock",
      "default_model": "mock-smart"
    },
    "local_fast": {
      "type": "openai_compatible",
      "base_url": "http://localhost:1234/v1",
      "api_key": "lm-studio",
      "default_model": "qwen/qwen3-1.7b"
    },
    "ollama": {
      "type": "ollama",
      "base_url": "http://localhost:11434",
      "default_model": "llama3.1:8b"
    },
    "openai": {
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "default_model": "gpt-4.1-mini"
    }
  },
  "routing": {
    "chat": {
      "provider": "local_fast",
      "fallback_provider": "mock"
    },
    "planning": {
      "provider": "local_fast",
      "fallback_provider": "mock"
    },
    "tool_selection": {
      "provider": "local_fast",
      "fallback_provider": "mock"
    },
    "tool_generation": {
      "provider": "openai",
      "fallback_provider": "mock"
    },
    "reflection": {
      "provider": "local_fast",
      "fallback_provider": "mock"
    },
    "core_review": {
      "provider": "openai",
      "fallback_provider": "mock"
    }
  }
}