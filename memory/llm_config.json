{
  "default_provider": "local_fast",
  "providers": {
    "mock": {
      "type": "mock",
      "default_model": "mock-smart",
      "timeout": 1.0
    },
    "local_fast": {
      "type": "openai_compatible",
      "base_url": "http://localhost:1234/v1",
      "api_key": "lm-studio",
      "default_model": "qwen/qwen3-1.7b",
      "timeout": 20.0
    },
    "openai": {
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "default_model": "gpt-4.1-mini",
      "timeout": 60.0
    },
    "ollama": {
      "type": "ollama",
      "base_url": "http://localhost:11434",
      "default_model": "llama3.1:8b",
      "timeout": 30.0
    }
  },
  "routing": {
    "chat": {
      "provider": "local_fast",
      "fallback_provider": "mock"
    },
    "planning": {
      "provider": "local_fast",
      "fallback_provider": "mock"
    },
    "tool_selection": {
      "provider": "local_fast",
      "fallback_provider": "mock"
    },
    "tool_generation": {
      "provider": "openai",
      "fallback_provider": "mock"
    },
    "reflection": {
      "provider": "local_fast",
      "fallback_provider": "mock"
    },
    "core_review": {
      "provider": "openai",
      "fallback_provider": "mock"
    },
    "code_review": {
      "provider": "openai",
      "fallback_provider": "mock"
    }
  },
  "provider_aliases": {
    "lmstudio": "local_fast",
    "lm-studio": "local_fast",
    "lm_studio": "local_fast",
    "local": "local_fast",
    "cloud": "openai",
    "cloud_expert": "openai",
    "chatgpt": "openai",
    "gpt": "openai",
    "openai_cloud": "openai"
  },
  "model_routes": {
    "chat": {
      "provider": "local_fast",
      "reason": "Fast local model for normal chat."
    },
    "planning": {
      "provider": "local_fast",
      "reason": "Fast local model for simple planning."
    },
    "tool_selection": {
      "provider": "local_fast",
      "reason": "Fast local model for capability gating/tool selection."
    },
    "reflection": {
      "provider": "local_fast",
      "reason": "Local model is sufficient for reflection."
    },
    "tool_generation": {
      "provider": "cloud_expert",
      "reason": "Tool and code generation should use the cloud expert model."
    },
    "core_review": {
      "provider": "cloud_expert",
      "reason": "Architecture/core review should use the cloud expert model."
    },
    "code_review": {
      "provider": "cloud_expert",
      "reason": "Code review should use the cloud expert model."
    }
  }
}