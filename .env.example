
OBSIDIAN_VAULT_ENABLED=true
OBSIDIAN_VAULT_PATH=
OBSIDIAN_INBOX_DIR=Pandora_Inbox

# Obsidian Vault Integration (MVP 23.5.3)
# Local path to your Obsidian vault. In Docker, mount your vault to /vault and set this to /vault.
OBSIDIAN_VAULT_ENABLED=false
OBSIDIAN_VAULT_PATH=
OBSIDIAN_INBOX_DIR=Pandora_Inbox
OBSIDIAN_MODE=read_write_inbox_only
OBSIDIAN_CLOUD_ALLOWED=false
