{
  "active_profile": "private",
  "default_provider": "local_fast",
  "profiles": {
    "private": {
      "cloud_expert": "openai"
    },
    "company": {
      "cloud_expert": "company_llm"
    }
  },
  "providers": {
    "mock": {
      "type": "mock",
      "default_model": "mock-smart",
      "timeout": 1.0
    },
    "local_fast": {
      "type": "openai_compatible",
      "base_url": "http://localhost:1234/v1",
      "api_key": "lm-studio",
      "default_model": "qwen/qwen3-1.7b",
      "timeout": 20.0
    },
    "openai": {
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "default_model": "gpt-4.1-mini",
      "timeout": 60.0
    },
    "company_llm": {
      "type": "openai_compatible",
      "base_url_env": "COMPANY_LLM_BASE_URL",
      "api_key_env": "COMPANY_LLM_API_KEY",
      "model_env": "COMPANY_LLM_MODEL",
      "default_model": "company-default-model",
      "timeout": 60.0
    },
    "ollama": {
      "type": "ollama",
      "base_url": "http://localhost:11434",
      "default_model": "llama3.1:8b",
      "timeout": 30.0
    }
  },
  "routing": {
    "chat": {"provider": "local_fast", "fallback_provider": "mock"},
    "planning": {"provider": "local_fast", "fallback_provider": "mock"},
    "tool_selection": {"provider": "local_fast", "fallback_provider": "mock"},
    "tool_generation": {"provider": "cloud_expert", "fallback_provider": "mock"},
    "tool_design": {"provider": "cloud_expert", "fallback_provider": "mock"},
    "reflection": {"provider": "local_fast", "fallback_provider": "mock"},
    "core_review": {"provider": "cloud_expert", "fallback_provider": "mock"},
    "code_review": {"provider": "cloud_expert", "fallback_provider": "mock"}
  },
  "provider_aliases": {
    "lmstudio": "local_fast",
    "lm-studio": "local_fast",
    "lm_studio": "local_fast",
    "local": "local_fast",
    "cloud": "cloud_expert",
    "cloud_expert": "cloud_expert",
    "chatgpt": "cloud_expert",
    "gpt": "cloud_expert",
    "openai": "openai",
    "openai_cloud": "openai",
    "company": "company_llm",
    "company_llm": "company_llm"
  },
  "model_routes": {
    "chat": {"provider": "local_fast", "reason": "Fast local model for normal chat."},
    "planning": {"provider": "local_fast", "reason": "Fast local model for simple planning."},
    "tool_selection": {"provider": "local_fast", "reason": "Fast local model for capability gating/tool selection."},
    "reflection": {"provider": "local_fast", "reason": "Local model is sufficient for reflection."},
    "tool_generation": {"provider": "cloud_expert", "reason": "Tool and code generation should use the active profile cloud expert."},
    "tool_design": {"provider": "cloud_expert", "reason": "Tool contract/design should use the active profile cloud expert."},
    "core_review": {"provider": "cloud_expert", "reason": "Architecture/core review should use the active profile cloud expert."},
    "code_review": {"provider": "cloud_expert", "reason": "Code review should use the active profile cloud expert."}
  }
}
